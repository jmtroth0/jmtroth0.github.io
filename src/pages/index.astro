---
import Base from "../layouts/Base.astro";

const description = "Jordan Roth's personal site.";
---
<Base title="Jordan Roth" description={description}>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Jordan Roth" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://www.jordanroth.xyz/" />
    <meta property="og:image" content="https://www.jordanroth.xyz/images/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Silhouette of a hiker on a rocky ridge against an orange night sky" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href="/assets/css/main.css" />
  </Fragment>

  <div class="image avatar"><img src="/images/photos/meanddapuppy-400.jpg" width="200" height="200" alt="a dog and his boy" /></div>

  <footer id="footer">
    <ul class="icons">
      <li><a href="mailto:jmtroth0@gmail.com" class="icon mail"><img src="/images/mail.svg" alt="email" /></a></li>
      <li><a href="https://github.com/jmtroth0" class="icon github"><img src="/images/github.svg" alt="github" /></a></li>
      <li><a href="https://www.linkedin.com/in/jmtroth0" class="icon linkedin"><img src="/images/linkedin.svg" alt="linkedin" /></a></li>
      <li><a href="https://portfolio.jordanroth.xyz/" class="icon"><img src="/images/camera.svg" alt="portfolio" /></a></li>
      <li><a href="/assets/docs/resume.pdf" class="icon"><img src="/images/contact.svg" alt="resume" /></a></li>
    </ul>
  </footer>
</Base>
